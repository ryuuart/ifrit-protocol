import os

import sigil.compose

def open(
    size: tuple[float, float] | list[float] = ...,
    *,
    background: str | None = ...,
    title: str = ...,
    headless: bool = ...,
    assets: str | os.PathLike[str] | None = ...,
) -> Window: ...

class Window:
    def __init__(
        self,
        size: tuple[float, float] | list[float] = ...,
        *,
        background: str | None = ...,
        title: str = ...,
        headless: bool = ...,
        assets: str | os.PathLike[str] | None = ...,
    ) -> None: ...
    def show(self, what: sigil.compose.Element | type[object] | object) -> object: ...
    @property
    def sketch(self) -> object: ...
    def still(self, path: str | os.PathLike[str], *, density: float = ...) -> str: ...
    def restart(self) -> None: ...
    def pump(self, seconds: float = ...) -> bool: ...
    def run(self, seconds: float | None = ...) -> None: ...
    def close(self) -> None: ...
    @property
    def isOpen(self) -> bool: ...
    @property
    def size(self) -> tuple[int, int]: ...
    @property
    def status(self) -> str: ...
    @property
    def errorLog(self) -> str: ...
    def __enter__(self) -> Window: ...
    def __exit__(self, *exception: object) -> None: ...

def installPromptHook() -> bool: ...
def pumpOpenWindows() -> bool: ...
