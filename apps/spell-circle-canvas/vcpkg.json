{
  "dependencies": [
    "alembic",
    "asio",
    "benchmark",
    "boost-container",
    "boost-container-hash",
    "boost-pfr",
    "boost-unordered",
    "cgltf",
    "choreograph",
    "concurrentqueue",
    "curl",
    "diligent-engine",
    "earcut-hpp",
    "entt",
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "openh264",
        "swscale",
        "vpx"
      ]
    },
    "flatbuffers",
    "glm",
    "gtest",
    {
      "name": "harfbuzz",
      "features": [
        "icu",
        {
          "name": "coretext",
          "platform": "osx"
        }
      ]
    },
    "icu",
    "minizip-ng",
    "openimageio",
    "shader-slang",
    {
      "name": "shader-slang",
      "host": true
    },
    {
      "$comment": [
        "version>= holds the port cmake/SkiaSanitizerAbi.h was written",
        "against. That header claims SkASAN.h's include guard by name to",
        "keep sanitized objects on the archive's layout, and a guard is",
        "only claimable while the name is the one the port's header",
        "declares. Raise both together."
      ],
      "name": "skia",
      "version>=": "151#2",
      "features": [
        "avif",
        "default-visibility",
        "graphite",
        "jpeg",
        "png",
        "vulkan",
        "webp",
        {
          "name": "metal",
          "platform": "osx"
        }
      ]
    },
    "simdjson",
    "spdlog",
    "stb",
    {
      "name": "syphon",
      "platform": "osx"
    },
    "tbb",
    {
      "name": "spout2",
      "features": [
        "dx"
      ],
      "platform": "windows & !uwp & !arm64"
    },
    "tinyobjloader",
    {
      "name": "usd",
      "default-features": false
    },
    "vulkan-headers",
    "yoga"
  ],
  "overrides": [
    {
      "$comment": [
        "The baseline's earcut-hpp drops one header into include/ and",
        "exports no package, so a consumer has to find the header by",
        "path. This version installs the library's own CMake package",
        "instead, and the triangulator is linked like everything else:",
        "find_package(earcut_hpp CONFIG) and one imported target."
      ],
      "name": "earcut-hpp",
      "version": "3.2.3"
    }
  ]
}
