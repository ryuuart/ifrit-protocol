// Faint light loses its weaker channels first, the way a film or tone
// curve's toe answers it: the straight colour, normalised to its peak, is
// raised to 1 + uDeepening × (1 − coverage), so a dense layer keeps its
// colour and a thin one sinks toward its strongest channel — orange toward
// red, yellow toward orange, a blue-leaning cyan toward blue — while its
// brightest channel holds. Coverage is kept.
uniform float uDeepening;

half4 main(half4 color) {
  if (color.a <= 0) return half4(0, 0, 0, color.a);
  float3 positive = max(float3(color.rgb), float3(0));
  float peak = max(max(positive.r, positive.g), positive.b);
  float3 hue = peak > 0 ? positive / peak : float3(0);
  float exponent = 1.0 + uDeepening * (1.0 - clamp(float(color.a), 0.0, 1.0));
  float3 deep = pow(hue, float3(exponent)) * peak;
  return half4(half3(deep), color.a);
}
