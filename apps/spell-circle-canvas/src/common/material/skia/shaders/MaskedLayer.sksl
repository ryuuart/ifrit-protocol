// A layer applied through a mask: what is beneath, the layer blended over
// it, and the mask read by one channel and remapped, mixed by the result.
uniform shader uUnder;
uniform shader uOver;
uniform shader uMask;
uniform float uChannel;  // 0 alpha, 1 luminance, 2 red, 3 green, 4 blue
uniform float uLow;
uniform float uHigh;
uniform float uInvert;
uniform float uOpacity;

half4 main(float2 xy) {
  half4 m = uMask.eval(xy);
  float v = uChannel < 0.5   ? float(m.a)
            : uChannel < 1.5 ? dot(float3(m.rgb), float3(0.2126, 0.7152, 0.0722))
            : uChannel < 2.5 ? float(m.r)
            : uChannel < 3.5 ? float(m.g)
                             : float(m.b);
  v = clamp((v - uLow) / max(uHigh - uLow, 1e-5), 0.0, 1.0);
  if (uInvert > 0.5) v = 1.0 - v;
  return mix(uUnder.eval(xy), uOver.eval(xy), half(v * uOpacity));
}
