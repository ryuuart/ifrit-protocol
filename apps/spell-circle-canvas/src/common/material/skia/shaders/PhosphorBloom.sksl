uniform shader content;
uniform float uRadius;
uniform float uThreshold;
uniform float uIntensity;
uniform float uChroma;
uniform float uHueDrift;  // radians the halo has turned at the outer radius
uniform float uTail;      // extra energy on the outermost kernel

half gate(half3 color) {
  half peak = max(color.r, max(color.g, color.b));
  return smoothstep(half(uThreshold), half(min(uThreshold + 0.30, 1.0)), peak);
}

half3 bright(float2 p) {
  half3 color = content.eval(p).rgb;
  return color * gate(color);
}

half3 ring(float2 p, float radius) {
  float diagonal = radius * 0.70710678;
  half3 sum = bright(p + float2( radius, 0.0));
  sum += bright(p + float2(-radius, 0.0));
  sum += bright(p + float2(0.0,  radius));
  sum += bright(p + float2(0.0, -radius));
  sum += bright(p + float2( diagonal,  diagonal));
  sum += bright(p + float2(-diagonal,  diagonal));
  sum += bright(p + float2( diagonal, -diagonal));
  sum += bright(p + float2(-diagonal, -diagonal));
  return sum * 0.125;
}

// The colour turned about the grey axis: hue moves, luminance and
// saturation hold, and a zero turn is the colour itself.
half3 drift(half3 color, float turn) {
  const half3 axis = half3(0.57735027);
  half cs = half(cos(turn));
  half sn = half(sin(turn));
  return color * cs + cross(axis, color) * sn +
         axis * dot(axis, color) * (1.0 - cs);
}

half4 main(float2 p) {
  half4 source = content.eval(p);
  half3 near = ring(p, uRadius * 0.28);
  half3 middle = ring(p, uRadius * 0.62);
  half3 far = ring(p, uRadius);

  // The decay tail turns hue in proportion to how far it has reached,
  // and only where the pixel is lit by a halo rather than by a source
  // of its own: a phosphor being excited holds its colour, one decaying
  // beside it drifts.
  if (uHueDrift != 0.0) {
    float turn = uHueDrift * (1.0 - float(gate(source.rgb)));
    near = drift(near, turn * 0.28);
    middle = drift(middle, turn * 0.62);
    far = drift(far, turn);
  }

  half3 common = near * 0.52 + middle * 0.31 + far * 0.17;
  half3 spectral = half3(
      near.r * 0.16 + middle.r * 0.29 + far.r * 0.55,
      near.g * 0.27 + middle.g * 0.50 + far.g * 0.23,
      near.b * 0.58 + middle.b * 0.29 + far.b * 0.13);
  half3 bloom = mix(common, spectral, half(uChroma));
  if (uTail != 0.0) bloom += far * half(uTail);
  return half4(source.rgb + bloom * half(uIntensity), source.a);
}
