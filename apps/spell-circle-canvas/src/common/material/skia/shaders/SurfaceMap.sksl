// One map of a surface, read unshaded: the colour stack and the surface's
// channels, handed back as the texture a metallic-roughness surface of
// that role is dressed with. Every role
// carries the colour stack's alpha as its coverage, premultiplied.
//
// uRole: 0 base colour, 1 normal, 2 roughness, 3 metallic, 4 occlusion,
// 5 emission, 6 occlusion, roughness and metallic packed into red, green
// and blue, 7 the clear coat's weight in red and its roughness in green.
// A surface that takes no light is its own colour: emission is the colour
// stack, the base is black, the normal faces the viewer, roughness and
// occlusion are one, metallic and the coat zero.
uniform shader uColor;
uniform shader uNormal;
uniform shader uRoughnessMap;
uniform shader uMetallicMap;
uniform shader uOcclusionMap;
uniform shader uEmissionMap;
uniform shader uClearcoatMap;
uniform shader uClearcoatRoughnessMap;

uniform float uRole;
uniform float uUnlit;
uniform float uHasNormal;
uniform float uNormalScale;
uniform float uNormalDirectX;
uniform float uHasRoughnessMap;
uniform float uRoughness;
uniform float uHasMetallicMap;
uniform float uMetallic;
uniform float uHasOcclusionMap;
uniform float uOcclusion;
uniform float uHasEmissionMap;
uniform float4 uEmission;
uniform float uEmissionStrength;
uniform float uHasClearcoatMap;
uniform float uClearcoat;
uniform float uHasClearcoatRoughnessMap;
uniform float uClearcoatRoughness;

float roughnessAt(float2 xy, bool unlit) {
  if (unlit) return 1.0;
  float value = uRoughness;
  if (uHasRoughnessMap > 0.5) value *= float(uRoughnessMap.eval(xy).r);
  return clamp(value, 0.0, 1.0);
}

float metallicAt(float2 xy, bool unlit) {
  if (unlit) return 0.0;
  float value = uMetallic;
  if (uHasMetallicMap > 0.5) value *= float(uMetallicMap.eval(xy).r);
  return clamp(value, 0.0, 1.0);
}

float occlusionAt(float2 xy, bool unlit) {
  if (unlit) return 1.0;
  float value = uOcclusion;
  if (uHasOcclusionMap > 0.5) value *= float(uOcclusionMap.eval(xy).r);
  return clamp(value, 0.0, 1.0);
}

half4 main(float2 xy) {
  half4 painted = uColor.eval(xy);
  float alpha = float(painted.a);
  if (alpha <= 0.0) return half4(0);
  bool unlit = uUnlit > 0.5;
  if (uRole < 0.5) return unlit ? half4(0, 0, 0, painted.a) : painted;
  float3 value;
  if (uRole < 1.5) {
    // Green points up the picture in what comes out, whichever way the
    // stated map was authored.
    float3 n = float3(0, 0, 1);
    if (!unlit && uHasNormal > 0.5) {
      float3 t = float3(uNormal.eval(xy).rgb) * 2.0 - 1.0;
      t.xy *= uNormalScale;
      n = normalize(float3(t.x, uNormalDirectX > 0.5 ? -t.y : t.y,
                           max(t.z, 0.001)));
    }
    value = n * 0.5 + 0.5;
  } else if (uRole < 2.5) {
    value = float3(roughnessAt(xy, unlit));
  } else if (uRole < 3.5) {
    value = float3(metallicAt(xy, unlit));
  } else if (uRole < 4.5) {
    value = float3(occlusionAt(xy, unlit));
  } else if (uRole < 5.5) {
    if (unlit) return painted;
    value = uEmission.rgb * uEmissionStrength;
    if (uHasEmissionMap > 0.5) value *= float3(uEmissionMap.eval(xy).rgb);
  } else if (uRole < 6.5) {
    value = float3(occlusionAt(xy, unlit), roughnessAt(xy, unlit),
                   metallicAt(xy, unlit));
  } else {
    float coat = 0.0;
    float coatRoughness = 0.0;
    if (!unlit) {
      coat = uClearcoat;
      if (uHasClearcoatMap > 0.5) coat *= float(uClearcoatMap.eval(xy).r);
      coatRoughness = uClearcoatRoughness;
      if (uHasClearcoatRoughnessMap > 0.5)
        coatRoughness *= float(uClearcoatRoughnessMap.eval(xy).r);
    }
    value = float3(clamp(coat, 0.0, 1.0), clamp(coatRoughness, 0.0, 1.0), 0.0);
  }
  return half4(half3(value * alpha), half(alpha));
}
