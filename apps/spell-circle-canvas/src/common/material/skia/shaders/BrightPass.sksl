// The layer with everything but its light taken out: the straight colour
// where it is brighter than the knee, carrying that brightness as its own
// coverage. What comes back is a LAYER to blur and lay back over the
// source, not light to add — which is why the gate is read on the
// straight colour and the alpha is written rather than kept: a pixel half
// covered by white is white, and a bright pass that read it premultiplied
// would call it grey and drop the edge of every source it has.
//
// It reads its own pixel and no neighbour, so it is a COLOUR FILTER
// rather than a pass over the layer: a filter graph carrying a program
// over coordinates is evaluated in the layer's own pixels and resampled
// onto a scaled canvas, and the sharp layer an emitted light is laid back
// over would be softened by a light that adds nothing.
uniform float uThreshold;
uniform float uTop;

half4 main(half4 color) {
  float a = max(float(color.a), 1e-4);
  float3 straight = float3(color.rgb) / a;
  float peak = max(max(straight.r, straight.g), straight.b);
  float coverage = smoothstep(uThreshold, uTop, peak) * a;
  return half4(half3(straight * coverage), half(coverage));
}
