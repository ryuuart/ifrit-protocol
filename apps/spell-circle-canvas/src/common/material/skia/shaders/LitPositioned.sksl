// Positioned light crosses local coordinates and normal gradients into the page.
const bool kPositionedLight = true;
uniform float4x4 uWorld;

bool pageAffine() {
  return uWorld[0].w == 0.0 && uWorld[1].w == 0.0 && uWorld[3].w == 1.0;
}
float pageDeterminant(out float2 a, out float2 b, out float scale) {
  a = uWorld[0].xy;
  b = uWorld[1].xy;
  scale = max(max(abs(a.x), abs(a.y)), max(abs(b.x), abs(b.y)));
  if (!(scale > 0.0)) return 0.0;
  a /= scale;
  b /= scale;
  return a.x * b.y - a.y * b.x;
}
float3 pageNormal(float3 n) {
  float2 a, b;
  float scale;
  float determinant = pageDeterminant(a, b, scale);
  if (!pageAffine() || !(abs(determinant) > 0.000001)) return n;
  // Inverse transpose of the page's XY linear transform; Z is unchanged.
  float2 slope = float2(b.y * n.x - a.y * n.y, -b.x * n.x + a.x * n.y);
  float3 transformed = scale >= 1.0
      ? float3(slope / scale, n.z * determinant)
      : float3(slope, n.z * determinant * scale);
  return unitOr(transformed * sign(determinant), float3(0, 0, 1));
}
float3 positionedLight(float2 xy, float3 axis, float3 position, float range,
                       float spot, float2 coneCosines, out float falloff) {
  falloff = 0.0;
  float2 a, b;
  float scale;
  float determinant = pageDeterminant(a, b, scale);
  if (!pageAffine() || !(abs(determinant) > 0.000001) || !(range > 0.0))
    return float3(0, 0, 1);
  float2 page = (uWorld * float4(xy, 0, 1)).xy;
  float3 delta = position - float3(page, 0);
  float largest = max(max(abs(delta.x), abs(delta.y)), abs(delta.z));
  if (!(largest < range)) return float3(0, 0, 1);
  float3 l = unitOr(delta, float3(0, 0, 1));
  float3 reach = delta / range;
  float window = max(1.0 - dot(reach, reach), 0.0);
  falloff = window * window;
  if (spot > 0.5) {
    // The source-facing axis and the vector toward the source reverse together.
    float cosine = clamp(dot(axis, l), -1.0, 1.0);
    float span = coneCosines.x - coneCosines.y;
    falloff *= span > 0.0
        ? clamp((cosine - coneCosines.y) / span, 0.0, 1.0)
        : (cosine >= coneCosines.y ? 1.0 : 0.0);
  }
  return l;
}
