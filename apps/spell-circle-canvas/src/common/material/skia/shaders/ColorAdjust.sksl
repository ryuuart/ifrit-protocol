// The CSS colour filter functions, over the straight colour with coverage
// kept: uMode 0 is brightness (the colour scaled by uAmount), 1 is contrast
// (scaled by uAmount about mid-grey), 2 is saturate (uAmount of the way from
// the luminance grey, CSS's matrix), and 3 is hue-rotate (uAmount radians
// around the luminance axis, CSS's matrix). Each is the Filter Effects
// definition of the function of the same name.
uniform float uMode;
uniform float uAmount;

half4 main(half4 color) {
  float a = max(float(color.a), 1e-4);
  float3 c = float3(color.rgb) / a;
  if (uMode < 0.5) {
    c = c * uAmount;
  } else if (uMode < 1.5) {
    c = (c - 0.5) * uAmount + 0.5;
  } else if (uMode < 2.5) {
    float s = uAmount;
    float3x3 m = float3x3(0.213 + 0.787 * s, 0.213 - 0.213 * s, 0.213 - 0.213 * s,
                          0.715 - 0.715 * s, 0.715 + 0.285 * s, 0.715 - 0.715 * s,
                          0.072 - 0.072 * s, 0.072 - 0.072 * s, 0.072 + 0.928 * s);
    c = m * c;
  } else {
    float k = cos(uAmount);
    float n = sin(uAmount);
    float3x3 m = float3x3(
        0.213 + k * 0.787 - n * 0.213, 0.213 - k * 0.213 + n * 0.143, 0.213 - k * 0.213 - n * 0.787,
        0.715 - k * 0.715 - n * 0.715, 0.715 + k * 0.285 + n * 0.140, 0.715 - k * 0.715 + n * 0.715,
        0.072 - k * 0.072 + n * 0.928, 0.072 - k * 0.072 - n * 0.283, 0.072 + k * 0.928 + n * 0.072);
    c = m * c;
  }
  c = clamp(c, 0.0, 1.0);
  return half4(half3(c * float(color.a)), color.a);
}
