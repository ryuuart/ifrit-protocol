half4 main(float2 p) {
  float2 q = p + seed * 61.0;
  float k = max(stretch, 0.01);
  float t = fbm3(q * float2(toothScale / k, toothScale * k));
  float3 c = grained(paint.rgb, t, tooth);
  float w = fbm3(q * wearScale + 11.0);
  c = grained(c, w, wear);
  return half4(half3(clamp(c, 0.0, 1.0)), 1.0);
}
