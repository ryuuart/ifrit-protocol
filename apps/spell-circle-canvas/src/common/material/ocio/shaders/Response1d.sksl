half4 main(float2 xy) {
  half4 c = content.eval(xy);
  float a = max(float(c.a), 0.0001);
  float3 rgb = clamp(float3(c.rgb) / a, 0.0, 1.0);
  float3 p = rgb * (lutSize - 1.0) + 0.5;
  float3 m = float3(lut.eval(float2(p.r, 0.5)).r,
                    lut.eval(float2(p.g, 0.5)).g,
                    lut.eval(float2(p.b, 0.5)).b);
  return half4(half3(m * a), c.a);
}
