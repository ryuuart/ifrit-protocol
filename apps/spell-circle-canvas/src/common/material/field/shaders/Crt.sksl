float noise(float2 p) {
  return fract(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453);
}

half3 source(float2 p) {
  float2 uv = (p - uBounds.xy) / max(uBounds.zw, float2(1));
  if (min(uv.x, uv.y) < 0 || max(uv.x, uv.y) >= 1) return half3(0);
  return content.eval(p).rgb;
}

half4 main(float2 p) {
  float2 size = max(uBounds.zw, float2(1));
  float2 uv = (p - uBounds.xy) / size;
  if (min(uv.x, uv.y) < 0 || max(uv.x, uv.y) >= 1) return half4(0);
  float2 cc = uv - 0.5;
  float dist = dot(cc, cc) * uCurvature;
  float2 warped = uv + cc * (1 + dist) * dist;
  if (min(warped.x, warped.y) < 0 || max(warped.x, warped.y) >= 1)
    return half4(0, 0, 0, 1);
  float frame = floor(uTime * 60);
  float2 q = uBounds.xy + warped * size;
  q.x += (noise(float2(floor(q.y), frame)) - 0.5) * uJitter;
  q.x += sin(warped.y * 24 + uTime * 4) * uSync;
  half3 texel = source(q);
  if (uRgbShift != 0) {
    half3 left = source(q - float2(uRgbShift, 0));
    half3 right = source(q + float2(uRgbShift, 0));
    texel = left * half3(0.10, 0.20, 0.30) +
            right * half3(0.30, 0.20, 0.10) + texel * 0.60;
  }
  half3 high = ((1.0 + 0.30) - 0.2 * texel) * texel;
  half3 low = ((1.0 - 0.30) + 0.1 * texel) * texel;
  float mask = 1 - abs(fract((q.y - uBounds.y) / max(uScanPitch, 1)) * 2 - 1);
  texel = mix(texel, mix(low, high, mask), clamp(uRaster, 0, 1));
  // The tube's light is the layer already blurred flat, read once at the
  // warped coordinate — so the halo is spread by a separable Gaussian
  // whose cost follows its own radius, rather than gathered per pixel
  // through the curvature at a fixed tap count that caps how far it can
  // reach before it starts leaving copies of fine lettering.
  if (uBloom > 0) texel += clamp(bloom.eval(q).rgb * uBloom, 0, 0.5);
  texel *= 1 - clamp(uVignette * dot(cc, cc) * 2, 0, 1);
  texel *= uBrightness * (1 + (noise(float2(frame, 7)) - 0.5) * uFlicker);
  texel += half3((noise(floor(p) + float2(frame, frame * 0.37)) - 0.5) * uNoise);
  return half4(clamp(texel, 0, 1), 1);
}
