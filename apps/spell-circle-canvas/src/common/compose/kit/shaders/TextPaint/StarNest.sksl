// STAR NEST: a volume of folded space marched along one ray per point,
// each step adding the light its fractal folding gathers and dimming with
// distance and with the dark matter the folding leaves.
const int foldings = 17;
const int volumeSteps = 20;

half4 main(float2 point) {
  float2 drift = textPaintDrift();
  float foldOffset = 0.53;
  float stepSize = 0.1;
  float zoom = 0.800;
  float tile = 0.850;
  float speed = 0.010;
  float brightness = 0.0015;
  float darkMatter = 0.300;
  float distanceFading = 0.730;
  float saturation = 0.850;

  float2 position = (point - origin) / extent - 0.5;
  position.y *= extent.y / extent.x;
  float3 direction = float3(position * zoom, 1.0);
  float travel = time * speed + 0.25;

  float firstAngle = 0.5 + drift.x * 1.5;
  float secondAngle = 0.8 + drift.y * 1.5;
  float2x2 firstTurn = float2x2(cos(firstAngle), sin(firstAngle),
                                -sin(firstAngle), cos(firstAngle));
  float2x2 secondTurn = float2x2(cos(secondAngle), sin(secondAngle),
                                 -sin(secondAngle), cos(secondAngle));
  direction.xz = firstTurn * direction.xz;
  direction.xy = secondTurn * direction.xy;
  float3 eye = float3(1.0, 0.5, 0.5);
  eye += float3(travel * 2.0, travel, -2.0);
  eye.xz = firstTurn * eye.xz;
  eye.xy = secondTurn * eye.xy;

  float depth = 0.1;
  float fade = 1.0;
  float3 gathered = float3(0.0);
  for (int volumeStep = 0; volumeStep < volumeSteps; volumeStep++) {
    float3 probe = eye + depth * direction * 0.5;
    probe = abs(float3(tile) - mod(probe, float3(tile * 2.0)));
    float previousLength = 0.0;
    float energy = 0.0;
    for (int folding = 0; folding < foldings; folding++) {
      probe = abs(probe) / dot(probe, probe) - foldOffset;
      energy += abs(length(probe) - previousLength);
      previousLength = length(probe);
    }
    float dimming = max(0.0, darkMatter - energy * energy * 0.001);
    energy *= energy * energy;
    if (volumeStep > 6) fade *= 1.0 - dimming;
    gathered += fade;
    gathered += float3(depth, depth * depth, depth * depth * depth * depth) *
                energy * brightness * fade;
    fade *= distanceFading;
    depth += stepSize;
  }
  gathered = mix(float3(length(gathered)), gathered, saturation);
  // Masked into thin glyph strokes, the volume at a screen's exposure
  // reads near black, so it is taken several stops brighter.
  return half4(half3(gathered * 0.055), 1.0);
}
