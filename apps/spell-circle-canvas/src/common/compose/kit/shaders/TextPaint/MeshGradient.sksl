// MESH GRADIENT: four colour regions meeting across the box, the lattice
// between them bent by the drift, with a violet bloom wandering inside.
half4 main(float2 point) {
  float2 drift = textPaintDrift();
  float2 position = (point - origin) / extent;
  float2 bent = position;
  bent.x += (bent.y - 0.5) * (0.11 * drift.x) +
            bent.y * (1.0 - bent.y) * (0.08 * drift.y);
  bent.y += (bent.x - 0.5) * (0.09 * drift.y) -
            bent.x * (1.0 - bent.x) * (0.06 * drift.x);
  float across = smoothstep(-0.12, 1.12, bent.x);
  float down = smoothstep(-0.12, 1.12, bent.y);

  half3 top = mix(half3(0.96, 0.20, 0.42), half3(0.98, 0.67, 0.18), half(across));
  half3 bottom =
      mix(half3(0.27, 0.12, 0.70), half3(0.02, 0.78, 0.76), half(across));
  half3 color = mix(top, bottom, half(down));

  float2 centre = float2(0.52 + 0.18 * drift.x, 0.48 + 0.16 * drift.y);
  float bloom = 1.0 - smoothstep(0.0, 0.62, length(bent - centre));
  color = mix(color, half3(0.53, 0.30, 0.94), half(bloom * 0.34));
  return half4(color, 1.0);
}
