// WATER: a blue field deepening down the box, its surface bent by two
// crossing waves, under the fine bright lattice of caustics where they
// cross.
half4 main(float2 point) {
  float2 boxOrigin = fieldOrigin();
  float2 boxExtent = fieldExtent();
  float2 drift = textPaintDrift();
  float2 position = (point - boxOrigin) / boxExtent;
  float waveAcross = sin(position.y * 18.0 - time * 2.1 + drift.x);
  float waveDown = cos(position.x * 15.0 + time * 1.6 + drift.y);
  float2 warped = position + float2(waveAcross, waveDown) * 0.035;

  half3 deep = half3(0.015, 0.10, 0.30);
  half3 middle = half3(0.02, 0.42, 0.68);
  half3 aqua = half3(0.08, 0.82, 0.80);
  half3 color = mix(deep, middle, half(smoothstep(-0.05, 0.72, warped.y)));
  color =
      mix(color, aqua, half(0.30 + 0.22 * sin(warped.x * 8.0 - time * 0.7)));

  float crossing = sin((warped.x + warped.y) * 34.0 + time * 2.0) *
                   cos((warped.x - warped.y) * 27.0 - time * 1.4);
  float caustic = pow(max(0.0, crossing), 7.0);
  color += half3(0.30, 0.48, 0.40) * half(caustic);
  return half4(color, 1.0);
}
