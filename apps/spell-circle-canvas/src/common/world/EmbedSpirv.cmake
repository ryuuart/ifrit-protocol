# Script mode: embeds SPIRV blobs into one header with a name->bytes
# table (kWorldPopSpirv). Inputs: OUT (header path), SPV_FILES (;-list).
file(WRITE "${OUT}" "// generated by EmbedSpirv.cmake — do not edit\n#pragma once\n#include <cstddef>\n")
set(_table "static const struct { const char *name; const unsigned char *data; size_t size; } kWorldPopSpirv[] = {\n")
foreach(_f IN LISTS SPV_FILES)
  get_filename_component(_stem ${_f} NAME_WE)
  string(REGEX REPLACE "^[^_]+_" "" _entry ${_stem})
  file(READ ${_f} _hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes ${_hex})
  file(APPEND "${OUT}" "static const unsigned char kSpv_${_entry}[] = {${_bytes}};\n")
  string(APPEND _table "    {\"${_entry}\", kSpv_${_entry}, sizeof(kSpv_${_entry})},\n")
endforeach()
string(APPEND _table "};\n")
file(APPEND "${OUT}" "${_table}")
