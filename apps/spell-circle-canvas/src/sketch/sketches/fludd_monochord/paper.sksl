// Fixed paper fibres, foxing and the shallow shadow of a bound folio.
float hash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}
float noise(float2 p) {
    float2 i = floor(p), f = fract(p);
    f = f * f * (3 - 2 * f);
    return mix(mix(hash(i), hash(i + float2(1, 0)), f.x),
               mix(hash(i + float2(0, 1)), hash(i + 1), f.x), f.y);
}
half4 main(float2 p) {
    float2 uv = p / uResolution;
    float fibre = hash(floor(uv * float2(1340, 1720)));
    float cloud = noise(uv * 13) * 0.013 + noise(uv * 49) * 0.009;
    float margin = pow(abs(uv.x - 0.5) * 2, 9) * 0.052;
    float gutter = exp(-uv.x * 28) * 0.063;
    float stain = pow(noise(uv * 25), 12) * 0.040;
    float3 base = float3(0.945, 0.927, 0.857);
    base -= cloud + fibre * 0.011 + margin + gutter;
    base -= stain * float3(0.35, 0.53, 0.8);
    return half4(half3(base), 1);
}
