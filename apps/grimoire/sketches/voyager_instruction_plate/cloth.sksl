float hash(float2 p) { return fract(sin(dot(p,float2(127.1,311.7)))*43758.5453); }
half4 main(float2 p) {
    float2 uv=p/uResolution;
    float pool=exp(-length((uv-float2(.34,.54))*float2(1.55,1.45)));
    float weave=sin(p.x*2.4)*sin(p.y*1.82)*.003+hash(floor(p))*.006;
    float3 colour=mix(float3(.027,.04,.044),float3(.083,.104,.105),pool)+weave;
    return half4(half3(colour),1);
}

