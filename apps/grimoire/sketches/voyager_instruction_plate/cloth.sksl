// A hash of products and fractions alone, so the raster canvas and the
// device answer the same pattern: a sine of a large argument rounds
// differently on each.
float hash(float2 p) {
    float3 q=fract(float3(p.xyx)*.1031);
    q+=dot(q,q.yzx+33.33);
    return fract((q.x+q.y)*q.z);
}
half4 main(float2 p) {
    float2 uv=p/uResolution;
    float pool=exp(-length((uv-float2(.34,.54))*float2(1.55,1.45)));
    float weave=sin(p.x*2.4)*sin(p.y*1.82)*.003+hash(floor(p))*.006;
    float3 colour=mix(float3(.027,.04,.044),float3(.083,.104,.105),pool)+weave;
    return half4(half3(colour),1);
}

