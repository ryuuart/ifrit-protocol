half4 main(float2 point) {
    float2 cell = abs(fract(point / 28.0) - 0.5);
    float grid = max(smoothstep(0.475, 0.5, cell.x), smoothstep(0.475, 0.5, cell.y));
    float scan = 0.5 + 0.5 * sin(point.y * 3.14159265);
    float light = grid * 0.027 + scan * 0.004;
    return half4(half3(0.038 + light * 0.4, 0.094 + light, 0.104 + light), 1.0);
}
