float hash(float2 p) { return fract(sin(dot(p,float2(127.1,311.7)))*43758.5453); }
half4 main(float2 p) {
    half4 ink=content.eval(p);
    float fibres=hash(floor(p*1.7));
    // A restrained variation in coverage preserves the finest letter cuts.
    float pressure=.89+.11*fibres;
    return half4(ink.rgb*pressure,ink.a*pressure);
}
