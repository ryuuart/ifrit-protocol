// A fixed source strip is sampled along projected exposure history. Camera
// travel and plane rotation change the sampling, without a previous frame.
float slitHash(float2 p) {
  p=fract(p*float2(123.34,456.21));
  p+=dot(p,p+45.32);
  return fract(p.x*p.y);
}
float slitNoise(float2 p) {
  float2 i=floor(p),f=fract(p);
  f=f*f*(3.0-2.0*f);
  return mix(mix(slitHash(i),slitHash(i+float2(1,0)),f.x),
             mix(slitHash(i+float2(0,1)),slitHash(i+float2(1,1)),f.x),f.y);
}
float2 slitRotate(float2 p,float a) {
  float c=cos(a),s=sin(a);
  return float2(c*p.x-s*p.y,s*p.x+c*p.y);
}
float slitLine(float distance,float width,float footprint) {
  return 1.0-smoothstep(width,width+max(footprint,0.0005),abs(distance));
}
float3 slitGel(float value,float side) {
  float3 violet=float3(0.24,0.038,0.61);
  float3 magenta=float3(0.96,0.045,0.28);
  float3 cyan=float3(0.036,0.72,0.91);
  float3 amber=float3(1.0,0.37,0.052);
  float3 a=mix(violet,magenta,smoothstep(0.16,0.61,value));
  float3 b=mix(cyan,amber,smoothstep(0.51,0.91,value));
  return mix(a,b,smoothstep(0.62,0.84,value+side*0.09));
}
float slitPeriodic(float phase,float width,float footprint) {
  float resolved=1.0-smoothstep(width,width+max(0.001,min(footprint,0.22)),abs(fract(phase)-0.5));
  return mix(resolved,min(1.0,width*2.0),smoothstep(0.20,0.78,footprint));
}
float slitArtwork(float2 p,float2 footprint) {
  float cloud=slitNoise(p*float2(0.83,0.17));
  float warp=(cloud-0.5)*0.17+(slitNoise(p*float2(3.7,0.7))-0.5)*0.033;
  p.x+=warp;
  float fibers=0.0;
  for(int tier=0;tier<3;++tier) {
    float frequency=tier==0?43.0:(tier==1?119.0:283.0);
    float axis=p.x*frequency+sin(p.y*0.61+float(tier)*3.1)*0.19;
    float identity=floor(axis);
    float seed=slitHash(float2(identity,float(tier)*11.7));
    float width=0.005+pow(seed,7.0)*0.19;
    float strand=slitPeriodic(axis+seed*0.43,width,footprint.x*frequency);
    float breakUp=slitNoise(float2(identity*0.107,p.y*(0.28+seed*0.41)+seed*16.0));
    float gate=smoothstep(0.20+seed*0.21,0.67,breakUp);
    fibers+=strand*gate*(tier==0?0.90:(tier==1?0.73:0.52));
  }
  float branch=sin(p.x*77.0+slitNoise(p*float2(4.1,0.9))*4.7)
                +sin(p.y*1.2+p.x*13.0)*0.43;
  float organic=slitLine(branch,0.044,max(footprint.x*77.0,footprint.y*2.0));
  organic*=smoothstep(0.34,0.74,slitNoise(p*float2(2.0,0.41)+9.2));
  organic*=1.0-smoothstep(0.26,0.87,footprint.x*77.0);
  float traceAxis=p.x*16.0+slitNoise(p*float2(0.3,0.11))*3.0;
  float broadRibbons=slitPeriodic(traceAxis,0.016,footprint.x*16.0);
  broadRibbons*=pow(slitNoise(float2(floor(traceAxis)*0.27,p.y*0.39)),2.0);
  float flakes=slitNoise(p*float2(63.0,13.0));
  flakes=mix(0.5,flakes,1.0-smoothstep(0.24,0.93,max(footprint.x*63.0,footprint.y*13.0)));
  float veil=pow(cloud,3.0)*(0.26+0.74*slitNoise(p*float2(9.0,0.47)));
  return (0.006+fibers*1.1+organic*0.09+broadRibbons*0.44+veil*0.077)
          *(0.33+flakes*1.11);
}

float3 slitPlane(float2 point,float clock,float footprint) {
  float width=abs(point.x);
  float depth=1.0/max(width,0.028);
  float farFade=1.0-smoothstep(23.0,42.0,depth);
  float nearFade=smoothstep(0.33,0.65,depth);
  float side=point.x<0.0?-1.0:1.0;
  float travel=clock*0.62+clock*clock*0.006;
  float history=depth+travel;
  float sourceAxis=point.y*depth*0.29+side*0.17;
  sourceAxis+=history*0.041*side;
  float2 source=float2(sourceAxis,history*0.63+side*1.97);
  float2 sourceFootprint=float2(footprint*depth*0.42,
                               footprint*depth*depth*0.74);
  float exposed=0.0;
  for(int sample=0;sample<3;++sample) {
    float offset=(float(sample)-1.0)*0.0032;
    exposed+=slitArtwork(source+float2(offset,offset*0.31),sourceFootprint);
  }
  exposed/=3.0;
  float broad=slitNoise(float2(sourceAxis*1.37,history*0.19+side*7.3));
  float band=slitNoise(float2(floor(sourceAxis*4.3)*0.31,history*0.067));
  float3 gel=side<0.0?mix(float3(0.23,0.024,0.53),float3(1.0,0.043,0.22),smoothstep(0.12,0.72,band))
                       :mix(float3(1.0,0.29,0.034),float3(0.73,0.067,0.033),smoothstep(0.28,0.86,band));
  float cyanCluster=exp(-abs(sourceAxis+0.08)*13.0)*smoothstep(0.31,0.67,broad);
  gel=mix(gel,float3(0.10,0.73,0.93),cyanCluster*(side>0.0?0.88:0.23));
  float light=0.52+1.05*broad;
  float streakGain=0.32+0.81*pow(1.0/(width+0.038),0.49);
  float activeVeil=0.20+0.80*smoothstep(0.31,0.67,slitNoise(float2(sourceAxis*0.61+side*7.1,history*0.071)));
  float3 exposure=gel*exposed*light*streakGain*4.7*activeVeil;
  float columnGrain=0.43+0.57*slitNoise(float2(point.y*3.1,history*0.18+side));
  float columnCenter=0.051+0.013*sin(point.y*1.3+side)+0.009*(columnGrain-0.6);
  float whiteColumn=exp(-pow((width-columnCenter)/(0.012+0.023*columnGrain),2.0));
  exposure+=float3(0.91,0.85,1.0)*whiteColumn*columnGrain*2.8;
  exposure+=gel*exp(-abs(width-0.062)/0.11)*columnGrain*0.36;
  float ridge=slitLine(point.y+0.027*sin(history*0.11+side),0.004,footprint);
  exposure+=mix(float3(0.25,0.63,0.92),float3(1,0.36,0.14),step(0.0,side))
            *ridge*0.70*(0.3+broad);
  float seam=slitLine(width-0.035,0.003,footprint);
  exposure+=float3(0.39,0.11,0.42)*seam*0.27;
  exposure*=farFade*nearFade;
  float horizonShadow=1.0-0.67*exp(-abs(point.y)*52.0);
  return exposure*horizonShadow;
}
float3 slitDoor(float2 p,float clock,float footprint) {
  float arrival=smoothstep(17.0,24.0,clock);
  float opening=mix(0.21,0.57,arrival);
  float3 exposure=float3(0);
  for(int wall=0;wall<2;++wall) {
    float side=wall==0?-1.0:1.0;
    float distance=p.x-side*opening;
    float scumble=slitNoise(float2(p.y*3.1+side*4.7,clock*0.061));
    float coreWidth=0.010+0.015*scumble;
    float core=exp(-abs(distance)/coreWidth);
    float skirt=exp(-abs(distance)/(side<0.0?0.15:0.105));
    float veil=exp(-pow((distance-side*0.082)/(0.20+0.11*scumble),2.0));
    float2 source=float2(p.y*0.89+distance*1.4,clock*0.34+side*3.1);
    float artwork=slitArtwork(source,float2(footprint*2.4,footprint*0.8));
    float3 gel=side<0.0?float3(0.77,0.047,0.35):float3(0.10,0.38,0.71);
    exposure+=gel*(veil*(0.10+artwork*2.2)+skirt*(0.27+scumble*0.24));
    exposure+=float3(1.0,0.88,0.91)*core*(2.4+scumble*3.2);
    exposure+=float3(0.68,0.25,0.53)*exp(-abs(distance)/(coreWidth*3.7))*0.60;
  }
  float lintel=exp(-pow((p.y+0.88)/(0.069+arrival*0.027),2.0));
  lintel*=exp(-pow(p.x/(opening+0.06),4.0));
  exposure+=float3(0.49,0.13,0.54)*lintel*(0.20+0.42*slitNoise(p*8.3));
  float interior=1.0-smoothstep(opening-0.14,opening-0.015,abs(p.x));
  exposure*=1.0-interior*0.97;
  return exposure;
}

half4 main(float2 xy) {
  float clock=clamp(seconds,0.0,24.0);
  float2 imageSize=max(resolution,float2(1));
  float2 p=(xy-imageSize*0.5)*2.0/imageSize.y;
  p-=float2(0.017*sin(clock*0.19),0.014*sin(clock*0.27));
  float footprint=2.0/(imageSize.y*max(uContentScale,0.20));
  float roll=smoothstep(8.5,11.3,clock)*1.57079633;
  float arrival=smoothstep(17.0,20.2,clock);
  roll*=1.0-arrival;
  float2 planes=slitRotate(p,roll);
  float3 exposure=slitPlane(planes,clock,footprint);
  float darkVoid=1.0-smoothstep(0.015,0.027,abs(planes.x));
  exposure*=1.0-darkVoid;
  float depthShadow=exp(-pow(p.x/(0.31+0.21*arrival),4.0)-pow(p.y/1.25,4.0));
  exposure*=1.0-depthShadow*arrival*0.98;
  exposure=mix(exposure,exposure*0.18+slitDoor(p,clock,footprint),arrival);
  float blackAxis=exp(-abs(planes.y)*87.0)*(1.0-arrival);
  exposure*=1.0-blackAxis*0.68;
  float3 density=1.0-exp(-max(exposure,0.0)*1.13);
  float vignette=1.0-0.16*smoothstep(0.82,2.05,length(p));
  density*=vignette;
  return half4(half3(clamp(density,0.0,1.0)),1);
}
