// A sentence becomes visible across its whole contour. The noise child
// is supplied by the material library; this body owns only its suspension.
half4 main(float2 point) {
  float density = uNoise.eval(point + float2(uTime * 3.0, -uTime * 1.2)).r;
  float arrival = 0.5 + 0.5 * sin(uTime * 0.392699 - 0.9);
  float opacity = smoothstep(0.02 + density * 0.46,
                            0.28 + density * 0.52, arrival);
  return half4(half(0.38 + opacity * 0.62));
}
